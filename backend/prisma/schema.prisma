}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model analytics {
  id            Int        @id @default(autoincrement())
  event_type    String     @db.VarChar(50)
  resource_type String?    @db.VarChar(50)
  resource_id   Int?
  session_id    String?    @db.VarChar(255)
  job_id        Int?
  user_id       Int?
  ip_address    String?    @db.Inet
  user_agent    String?
  metadata      Json?
  created_at    DateTime?  @default(now()) @db.Timestamp(6)
  jobs          jobs?      @relation(fields: [job_id], references: [id], onUpdate: NoAction)
  app_users     app_users? @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([created_at], map: "idx_analytics_created_at")
  @@index([event_type], map: "idx_analytics_event_type")
  @@index([job_id], map: "idx_analytics_job_id")
  @@index([user_id], map: "idx_analytics_user_id")
  @@index([resource_type, resource_id])
}

