# Database Configuration - PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres?sslmode=require&family=4
DB_HOST=YOUR_SUPABASE_HOST
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=postgres

# JWT Configuration
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_EXPIRE=7d

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Configuration (if needed)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Gmail SMTP Configuration for OTP
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASS=your_app_password

# Frontend URLs for CORS
FRONTEND_URL=https://your-domain.vercel.app
ADMIN_URL=https://your-admin-domain.vercel.app

# Other configurations
NODE_ENV=production
PORT=5000
