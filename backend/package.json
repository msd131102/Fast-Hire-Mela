{
  "name": "fasthiremela-backend",
  "version": "1.0.0",
  "description": "Backend for FastHireMela job listing platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'Backend build complete'",
    "start:silent": "node server-silent.js > /dev/null 2>&1 &",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "stop:pm2": "pm2 stop fasthiremela-backend",
    "restart:pm2": "pm2 restart fasthiremela-backend",
    "delete:pm2": "pm2 delete fasthiremela-backend",
    "logs:pm2": "pm2 logs fasthiremela-backend",
    "monit:pm2": "pm2 monit",
    "test": "jest",
    "setup:db": "node scripts/setup-database.cjs"
  },
  "keywords": [
    "job",
    "listing",
    "platform",
    "nodejs",
    "express",
    "postgresql"
  ],
  "author": "FastHireMela",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.11",
    "pg": "^8.11.3",
    "razorpay": "^2.9.2",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
